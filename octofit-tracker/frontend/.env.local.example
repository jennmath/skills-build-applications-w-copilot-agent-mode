# Example .env.local for frontend
# Set VITE_CODESPACE_NAME when running inside GitHub Codespaces so the frontend can
# reach the backend service exposed on port 8000 by the Codespace instance.
# Replace "your-codespace-name" with the actual Codespace name.
VITE_CODESPACE_NAME=your-codespace-name

# If VITE_CODESPACE_NAME is not set the app will fall back to http://localhost:8000/api/
